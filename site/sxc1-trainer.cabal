cabal-version:      3.0
name:               sxc1-trainer
version:            0.1.0.0
synopsis:           SXC-1 Trainer - M0 toolchain spike
build-type:         Simple

extra-source-files: ../translations/*.md
                    ../content/exercises/*.md
                    ../content/exercises/INDEX
                    ../content/id-registry.tsv

common app-options
  if arch(wasm32)
    ghc-options: -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start"
    cpp-options: -DWASM
  if arch(javascript)
    ld-options:  -sEXPORTED_RUNTIME_METHODS=HEAP8
    cpp-options: -DJS

library
  exposed-modules:  SXC1.Content.Types
                    SXC1.Content.Embed
                    SXC1.Content.Markdown
                    SXC1.Content.Outline
                    SXC1.Content.Stats
                    SXC1.Route
                    SXC1.Exercise.Types
                    SXC1.Exercise.Reader
                    SXC1.Exercise.Parse
                    SXC1.Exercise.Lint
                    SXC1.Exercise.Verify
                    SXC1.Exercise.Engine
                    SXC1.Exercise.Report
                    SXC1.Midi.Spec
                    SXC1.Midi.Table
                    SXC1.Progress.Types
                    SXC1.Progress.Scheduler
                    SXC1.Progress.Codec
  hs-source-dirs:   src
  build-depends:    base < 5, text, containers, bytestring, template-haskell
  default-language: Haskell2010
  ghc-options:      -O1 -Wall -ferror-spans

executable app
  import:           app-options
  main-is:          Main.hs
  hs-source-dirs:   app
  other-modules:    View.Blocks
                    View.Pages
                    -- M7 W1: ONE bundle module for ONE bundle grammar --
                    -- the exercise corpus AND the manual text ship as
                    -- fetched per-language bundles under the same
                    -- framing, the same all-or-nothing acceptance and
                    -- the same wasm-embedded expectation.
                    Bundle
                    Exercises.Corpus
                    -- GENERATED by scripts/emit-content-bundles.py
                    -- --manifest-hs (build-site.sh step 3a, before this
                    -- build): the build-time bundle expectation, both
                    -- kinds.
                    Bundle.Manifest
                    View.Exercise
                    Progress.Store
                    View.Progress
                    Device.Midi
                    I18n
  build-depends:    base < 5, miso == 1.12.0.0, sxc1-trainer, text, containers
  default-language: Haskell2010
  ghc-options:      -O1 -Wall -ferror-spans

executable content-check
  main-is:          CheckContent.hs
  hs-source-dirs:   test
  -- M7 W1: the manual translations are TH-embedded HERE now (the app
  -- fetches them as bundles instead) -- see EmbeddedTranslations.
  other-modules:    EmbeddedTranslations
  build-depends:    base < 5, text, containers, template-haskell, sxc1-trainer
  default-language: Haskell2010
  ghc-options:      -O1 -Wall -ferror-spans

executable exercise-check
  main-is:          CheckExercises.hs
  hs-source-dirs:   test
  build-depends:    base < 5, text, containers, bytestring, directory, filepath, time, sxc1-trainer
  default-language: Haskell2010
  ghc-options:      -O1 -Wall -ferror-spans

executable progress-check
  main-is:          CheckProgress.hs
  hs-source-dirs:   test
  -- directory: the group-11 purity guard discovers the SXC1.Progress
  -- module list from disk (M3 gate NEW3) instead of hardcoding it.
  build-depends:    base < 5, text, containers, directory, sxc1-trainer
  default-language: Haskell2010
  ghc-options:      -O1 -Wall -ferror-spans

executable registry-check
  main-is:          CheckRegistry.hs
  hs-source-dirs:   test
  build-depends:    base < 5, text, containers, directory, filepath, sxc1-trainer
  default-language: Haskell2010
  ghc-options:      -O1 -Wall -ferror-spans
